\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces YOLO-CLIP image-level cross-entropy over 20 epochs. Training loss declines throughout, while familiar-camera validation (\texttt  {id\_val}) loss is lowest at epoch 9 (1.4783), the checkpoint selected before threshold tuning. No held-out-camera validation or test data enter these curves.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:training}{{2}{5}{YOLO-CLIP image-level cross-entropy over 20 epochs. Training loss declines throughout, while familiar-camera validation (\texttt {id\_val}) loss is lowest at epoch 9 (1.4783), the checkpoint selected before threshold tuning. No held-out-camera validation or test data enter these curves}{figure.2}{}}
